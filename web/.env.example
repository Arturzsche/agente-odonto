# URL pública do site (usada em metadados). Em desenvolvimento, pode ficar comentada.
# NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# E-mail comercial exibido em /contato e nos CTAs "Agendar demonstração".
# Sem esta variável, a página informa que o canal de contato está em configuração.
# NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com.br

# Somente servidor (NUNCA use o prefixo NEXT_PUBLIC_). Endereço HTTPS que recebe, via POST
# em JSON, os pedidos do formulário de demonstração (ex.: automação de e-mail ou CRM).
# Sem esta variável, o formulário informa que o envio não está configurado e nada é enviado.
# DEMO_REQUEST_WEBHOOK_URL=https://hooks.exemplo.com.br/demonstracao
