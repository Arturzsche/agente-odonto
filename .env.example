# ===== Servidor =====
PORT=3000

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ===== Evolution API (docker-compose.yml) =====
# Deixe EVOLUTION_API_URL vazio para MODO SIMULAÇÃO (respostas só aparecem no log/console)
EVOLUTION_API_URL=http://localhost:8080
# Chave que VOCÊ inventa: a Evolution passa a exigi-la e o agente a envia no header "apikey".
# Use só letras e números (o Docker interpreta "$" de forma especial).
EVOLUTION_API_KEY=troque-por-uma-chave-longa-aleatoria
EVOLUTION_INSTANCE=clinica
# Senha do PostgreSQL da Evolution (só letras e números; vai dentro de uma URL de conexão).
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-forte

# ===== Banco de dados (PostgreSQL do docker-compose, via Prisma) =====
# Mesmo servidor da Evolution, mas no banco "agente_odonto" (criado pelo "npm run db:migrate").
# A senha (aqui "evolution") deve ser IGUAL à EVOLUTION_DB_PASSWORD acima.
# Do Windows/host use localhost:5432. Se o agente rodar dentro do Docker, troque por postgres:5432.
DATABASE_URL=postgresql://evolution:evolution@localhost:5432/agente_odonto?schema=public
HISTORY_LIMIT=10
# Horas sem mensagens até a conversa virar um novo atendimento (contexto limpo para a IA).
SESSION_TIMEOUT_HOURS=12

# ===== Google Calendar =====
# false = usa o MOCK (2 horários fictícios). true = usa a API real do Google.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
# Caminho para o JSON da Service Account (compartilhe a agenda com o e-mail dela)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
CLINIC_TIMEZONE=America/Sao_Paulo
CLINIC_OPEN_HOUR=8
CLINIC_CLOSE_HOUR=18
APPOINTMENT_DURATION_MIN=60
